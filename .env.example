# Copy to backend/.env and adjust as needed.
# Everything is optional; defaults are in backend/app/config/settings.py.

FLOOD_ENVIRONMENT=development
FLOOD_HOST=127.0.0.1
FLOOD_PORT=8000

# Model provider (S07): mock | openai | ollama | openai_compatible
# mock = deterministic, offline (tests, headless worlds)
FLOOD_MODEL_PROVIDER=mock
FLOOD_MODEL_NAME=
FLOOD_MODEL_BASE_URL=
FLOOD_MODEL_API_KEY=
FLOOD_MODEL_TEMPERATURE=0.7
FLOOD_MODEL_MAX_TOKENS=512
FLOOD_MODEL_TIMEOUT_S=30
